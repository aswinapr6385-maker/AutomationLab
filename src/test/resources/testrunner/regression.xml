<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="QA Automation Labs Regression Suite">

    <listeners>
        <listener class-name="com.qa.qaautomationlabs.listners.ExtentReportListener"/>
        <listener class-name="com.qa.qaautomationlabs.listners.RetryListener"/>
    </listeners>

    <test name="Login Tests">

        <classes>

            <class name="com.qa.qaautomationlab.test.login_Test"/>

        </classes>

    </test>

    <test name="Add To Cart Tests">

        <classes>

            <class name="com.qa.qaautomationlab.test.Addtocart_test"/>

        </classes>

    </test>

</suite>