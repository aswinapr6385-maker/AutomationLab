pipeline {

    agent any

    tools {
        maven 'Maven-3.9.16'
    }

    environment {
        // Run in SAFE mode on CI: heals locators dynamically in memory & generates reports without modifying git repo
        HEALING_MODE = 'SAFE'
        HEADLESS = 'true'
    }

    stages {

        stage('Environment Check') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                sh 'mvn exec:java -e -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args="install chromium"'
            }
        }

        stage('Regression Automation Test') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    // Added -Dhealing.mode flag to enable self-healing safely in CI
                    sh 'mvn clean test -Dsurefire.suiteXmlFiles=src/test/resources/testrunner/regression.xml -Dhealing.mode=${HEALING_MODE}'
                }
            }
        }

        stage('Publish Extent Report') {
            steps {
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'test-output',
                    reportFiles: 'TestExecutionReport.html',
                    reportName: 'HTML Extent Report',
                    reportTitles: 'QA Automation Labs Test Execution'
                ])
            }
        }

        stage('Publish Self-Healing Report') {
            steps {
                // Publishes the dark-themed Self-Healing Dashboard alongside Extent Report
                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'reports',
                    reportFiles: 'self-healing-report.html',
                    reportName: 'Self-Healing Dashboard Report',
                    reportTitles: 'Self-Healing Automation Metrics'
                ])
            }
        }
    }

    post {

        always {
            echo 'Pipeline execution completed.'
            // Archive screenshots of healed elements and history JSON for audit
            archiveArtifacts artifacts: 'reports/**,screenshots/**,healing-data/**', allowEmptyArchive: true
        }

        success {
            echo 'Regression tests completed successfully!'
        }

        failure {
            echo 'Regression tests failed. Check the Jenkins console, Extent Report, and Self-Healing Dashboard.'
        }
    }
}